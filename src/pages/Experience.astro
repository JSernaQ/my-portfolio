--- 
import { experiences } from "../data/Experience";
---

<section id="experience" class="md:px-36 mx-4 p-4 xl:px-70 min-h-screen pt-26 ">
    <div class="flex mb-6">
        <p
            class="text-gray-400    "
            style="font-family: 'JetBrains Mono', monospace;"
        >
            $
        </p>
        <p
            class="text-green-500"
            style="font-family: 'JetBrains Mono', monospace;"
        >
            cat experience.log
        </p>
        <span class="subtle-blink text-green-500 ml-1 bg-green-500">:)</span>
    </div>
    <div class="flex flex-col mb-8 gap-y-2">
        <h2 class="mb-2 text-2xl md:text-4xl font-bold text-white">Where I’ve built things.</h2>
        <p class="text-sm md:text-base text-gray-400">
            Professional experience focused on automation, software and digital transformation.
        </p>
    </div>
    <div class="flex w-full gap-x-4">
        {
            experiences.map(exp => (
                <div
                    class="bg-gray-800/40 px-4 py-4 rounded-lg flex flex-3 flex-col gap-y-2 border-1 border-gray-800
                    hover:translate-y-[-4px] transition duration-500
                    hover:shadow-md hover:shadow-gray-700/40"
                >
                    <div class="flex flex-row flex-3 items-center justify-between">
                        <h2 class="text-base md:text-lg font-bold text-white">
                            {exp.role}
                        </h2>
                        <p class="text-xs bg-gray-900/20 border-1 border-gray-800 py-1 px-5 rounded-2xl text-green-400">
                            {exp.period}
                        </p>
                    </div>
                    <p class="text-sm md:text-base pb-2 text-blue-300">
                        {exp.company} - {exp.location}
                    </p>
                    {
                        exp.achievements.map(achievement => (
                            <p class="text-gray-400 text-xs md:text-sm items-center">
                                <span class="text-green-400 font-bold">•</span> {achievement}
                            </p>
                        ))
                    }
                </div>
            ))
        }
        <div class="hidden lg:flex flex-1">

        </div>

    </div>
    <!-- <p class="w-full flex justify-center mt-16 font-bold text-green-400 text-lg">Coming soon..</p> -->
</section>