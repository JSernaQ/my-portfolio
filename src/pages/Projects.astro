---
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/Projects";
---

<section id="projects" class="md:px-36 xl:px-70 min-h-screen pt-26">
    <div class="flex mb-6">
        <p
            class="text-gray-400 mr-2"
            style="font-family: 'JetBrains Mono', monospace;"
        >
            $
        </p>
        <p
            class="text-green-500"
            style="font-family: 'JetBrains Mono', monospace;"
        >
            ls ./projects
        </p>
        <span class="subtle-blink text-green-500 ml-1">:)</span>
    </div>
    <div class="flex flex-col mb-8 gap-y-2">
        <h2 class="mb-2 text-4xl font-bold text-white">Things I've built.</h2>
        <p class="text-gray-400">
            Projects where software, automation and real-world problems meet.
        </p>
    </div>
    <!-- Proyectos destacados -->
    <div class="flex flex-col gap-y-4">
        {
            projects.slice(0, 1).map(project => (
                <ProjectCard project={project} />
            ))
        }
        <div class="flex gap-x-4">
            {
                projects.slice(1, 3).map(project => (
                    <ProjectCard project={project} />
                ))
            }
        </div>
        <div class="w-full flex justify-center mt-6">
            <a
                href="/projects"
                class="border-2 border-green-500 hover:bg-green-600 px-14 py-3 rounded-lg bg-transparent
                hover:text-black font-semibold animation duration-600 text-green-600 hover:border-green-600
                hover:shadow-lg hover:shadow-green-700/40 hover:translate-y-[-2px]"
            >
                Show all
            </a>
        </div>
    </div>
</section>