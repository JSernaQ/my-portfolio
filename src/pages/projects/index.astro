---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../Navbar.astro";
import Footer from "../Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/Projects";
---

<Layout>
    <Navbar />
    <main class="md:px-36 xl:px-70 pt-26 min-h-screen">
        <div class="flex mb-6 mt-4">
            <p
                class="text-gray-400 mr-2"
                style="font-family: 'JetBrains Mono', monospace;"
            >
                $
            </p>
            <p
                class="text-green-500"
                style="font-family: 'JetBrains Mono', monospace;"
            >
                cat ./projects/*.md 
            </p>
            <span class="subtle-blink text-green-500 bg-green-500 ml-3"> :)</span>
        </div>
        <div class="flex flex-col mb-8 gap-y-2">
            <h2 class="mb-2 text-4xl font-bold text-white">All projects.</h2>
            <p class="text-gray-400">
                Everything I've built — web, mobile and automation.
            </p>
        </div>
        <div class="flex flex-col gap-y-4">
            {
                projects.map((project) => (
                    <ProjectCard project={project} />
                ))
            }
        </div>
    </main>
    <Footer />
</Layout>