---
const isProjectsPage = Astro.url.pathname === "/projects" || Astro.url.pathname.startsWith("/projects/");
const anchor = (id:any) => (isProjectsPage ? `/#${id}` : `#${id}`);
---

<style>

    header {
        z-index: 1000;
    }

    .ham-menu span{
        transition: all 0.5s ease-in-out;
    }

    .ham-menu.activate span:nth-child(1){
        transform: rotate(45deg) translate(4px, 7px);
    }
    
    .ham-menu.activate span:nth-child(2){
        opacity: 0;
    }
   
    .ham-menu.activate span:nth-child(3){
        top: 50%;
        transform: rotate(-45deg) translate(4px, -7px);
    }

    .slide-menu{
        translate: -800px;
    }
    
    .slide-menu li{
        transition: all 1s ease-in-out;
    }
    

    .slide-menu.activate li:nth-child(1){
        translate: 798px;
        font-weight: bold;
        transition: all 0.2s ease-in-out 0.1s;
    }
    
    .slide-menu.activate li:nth-child(2){
        translate: 798px;
        font-weight: bold;
        transition: all 0.3s ease-in-out 0.2s;
    }
    
    .slide-menu.activate li:nth-child(3){
        translate: 798px;
        font-weight: bold;
        transition: all 0.4s ease-in-out 0.3s;
    }
    
    .slide-menu.activate li:nth-child(4){
        translate: 798px;
        font-weight: bold;
        transition: all 0.5s ease-in-out 0.4s;
    }
    

</style>

<header class="fixed w-full backdrop-blur-md bg-black/2">
    <nav class="hidden sm:flex justify-center p-8 border-b border-gray-950/10">
        <ul
            class="flex gap-x-20 lg:gap-x-40 justify-between font-bold text-white"
        >
            <li>
                <a
                    class="relative text-base leading-6 hover:text-gray-400 transition-colors duration-500 cursor-pointer
                        after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0
                        after:bg-green-500 after:transition-all after:duration-500
                        hover:after:w-full"
                    href={anchor("hero")}
                >
                    Home
                </a>
            </li>
            <li>
                <a
                    class="relative text-base leading-6 text-center hover:text-gray-400 transition-colors duration-500 cursor-pointer
                        after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0
                        after:bg-green-500 after:transition-all after:duration-500
                        hover:after:w-full"
                    href={anchor("experience")}
                >
                    Experience
                </a>
            </li>
            <li>
                <a
                    class="relative text-base leading-6 hover:text-gray-400 transition-colors duration-500 cursor-pointer
                        after:absolute after:h-[2px] after:left-0 after:bottom-0 after:w-0
                        after:bg-green-500 after:transition-all after:duration-500
                        hover:after:w-full"
                    href={anchor("projects")}
                >
                    Projects
                </a>
            </li>
            <li>
                <a
                    class="relative text-base leading-6 text-center hover:text-gray-400 transition-colors duration-500 cursor-pointer
                        after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0
                        after:bg-green-500 after:transition-all after:duration-500
                        hover:after:w-full"
                    href={anchor("contact-me")}
                >
                    Contact me
                </a>
            </li>
        </ul>
    </nav>
    <nav class="sm:hidden flex justify-between items-center p-8">
        <!-- Mobile Menu -->

        <div class="relative cursor-pointer ham-menu">
            <span class="absolute h-1 w-8 -translate-y-2 bg-gray-400"></span>
            <span class="absolute h-1 w-8 translate-y-0 bg-gray-400"></span>
            <span class="absolute h-1 w-8 translate-y-2 bg-gray-400"></span>
        </div>

        <h1  class="text-white font-bold">Juan Serna</h1>
    </nav>
    <section class="absolute sm:hidden">
        <ul class="relative w-screen flex-col space-y-0.5 slide-menu">
            <li class="flex border-2 border-gray-950/50 active:bg-gray-300 items-center pl-8 h-15 rounded-r-2xl bg-gray-900/95"><a href={anchor("hero")} class="flex items-center h-full w-full">Home</a></li>
            <li class="flex border-2 border-gray-950/50 active:bg-gray-300 items-center pl-8 h-15 rounded-r-2xl bg-gray-900/95"><a href={anchor("experience")} class="flex items-center h-full w-full">Experience</a></li>
            <li class="flex border-2 border-gray-950/50 active:bg-gray-300 items-center pl-8 h-15 rounded-r-2xl bg-gray-900/95"><a href={anchor("projects")} class="flex items-center h-full w-full">Projects</a></li>
            <li class="flex border-2 border-gray-950/50 active:bg-gray-300 items-center pl-8 h-15 rounded-r-2xl bg-gray-900/95"><a href={anchor("contact-me")} class="flex items-center h-full w-full">Contact Me</a></li>
        </ul>
    </section>
</header>

<script>
    const hamMenu = document.querySelector('.ham-menu');
    const slideMenu = document.querySelector('.slide-menu');
    
    hamMenu?.addEventListener('click', () => {
        hamMenu?.classList.toggle('activate')
        slideMenu?.classList.toggle('activate')
    });
    
    slideMenu?.addEventListener('click', () => {
        hamMenu?.classList.remove('activate')
        slideMenu?.classList.remove('activate')
    });

</script>