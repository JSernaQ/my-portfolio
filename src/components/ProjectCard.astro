---
interface Props {
    project: {
        name: string;
        slug: string;
        category: string[];
        subtitle: string;
        description: string;
        technologies: {
            name: string;
            icon: string;
        }[];
        github?: string | null;
        demo?: string | null;
    };
}

const { project } = Astro.props;
---

<div class="flex flex-1">
    <div
        class="bg-gray-800/40 p-6 rounded-lg flex flex-col gap-y-2 border-1 border-gray-800
                hover:translate-y-[-4px] transition duration-500
                hover:shadow-md hover:shadow-gray-700/40"
    >
        <h2 class="font-bold text-xl mb-2">{project.name}</h2>
        <p class="text-sm md:text-base text-gray-400">
            <span class="font-bold text-gray-200"
                >{project.subtitle}</span
            > {project.description}
        </p>
        <div class="flex flex-col md:flex-row gap-x-2 items-center mt-4">
            <div class="flex flex-2 gap-2 w-full justify-center md:justify-start items-center ">
                {
                    project.technologies.slice(0, 3).map((tech) => (
                        <div
                            class="flex gap-x-2 items-center justify-center bg-gray-800/80 px-4 py-2 rounded-full transition duration-400
                                    border-1 border-gray-800 hover:border-gray-700 shadow-lg hover:translate-y-[-2px]"
                        >
                            <img src={tech.icon}  alt={project.slug} class="h-6 w-6" />
                            <span class="hidden md:flex">{tech.name}</span>
                        </div>
                    ))
                }
                <p class="hidden">•••</p>
            </div>
            <div class="flex flex-1 w-full justify-center md:justify-end items-center md:pr-2 gap-x-6 mt-6 md:mt-0">
                {project.demo && (
                    <a
                        href={project.demo}
                        target="_blank"
                        class="text-blue-400 hover:text-blue-300 font-semibold transition-colors duration-500"
                    >
                        Demo
                    </a>
                )}
                <a
                    href={project.github ?? "#"}
                    target={project.github ? "_blank" : undefined}
                    class="text-green-500 hover:text-green-400 transition-colors duration-500"
                >
                    More details
                </a>
            </div>
        </div>
    </div>
</div>
